# KvittoApp companion server — copy to .env and adjust.
# Every value here has a working default; nothing is required for a LAN setup.

# --- network ---
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info
# Address phones and other devices use to reach this server. Set this when
# running behind HTTPS, a reverse proxy, Docker, or a non-default hostname.
# KVITTO_PUBLIC_URL=https://kvitto.example.com

# Browser origins allowed to call this server. Leave unset only behind a VPN:
# with it unset, any website a paired user visits can use their token.
KVITTO_CORS_ORIGINS=https://kvitto.example.com

# Set when running behind nginx/Caddy/Traefik so rate limiting sees real IPs.
KVITTO_TRUST_PROXY=false

# --- storage ---
KVITTO_DATA_DIR=./data
KVITTO_DB_FILE=kvitto.sqlite
# Optional encryption key for synchronized secrets. When omitted, the server
# creates data/secrets.key with owner-only permissions. Back up that file too.
# KVITTO_SECRETS_KEY=replace-with-a-long-random-value
KVITTO_MAX_BLOB_BYTES=12582912
KVITTO_MAX_BODY_BYTES=25165824
KVITTO_PULL_PAGE_SIZE=500
KVITTO_PAIRING_TTL_MINUTES=15

# --- AI proxy (optional) ---
# Set these to let devices parse receipts without holding an API key
# themselves. Leave KVITTO_AI_PROVIDER empty to disable the proxy entirely.
# KVITTO_AI_PROVIDER=anthropic
# KVITTO_AI_API_KEY=sk-ant-...
# KVITTO_AI_MODEL=claude-opus-5
# KVITTO_AI_MAX_TOKENS=16000
# Models a device may request. Defaults to KVITTO_AI_MODEL alone, so a device
# cannot run up a bill on a model you did not choose.
# KVITTO_AI_ALLOWED_MODELS=claude-opus-5,claude-sonnet-5

# For OpenAI or an OpenAI-compatible endpoint instead:
# KVITTO_AI_PROVIDER=openai
# KVITTO_AI_BASE_URL=https://api.openai.com/v1
# KVITTO_AI_API_KEY=sk-...
# KVITTO_AI_MODEL=gpt-4o

# --- the local model (optional) ---
# Reads synced receipts with a vision model running on this machine. Nothing
# leaves your network and no API key is involved. Needs Ollama installed; the
# server starts it if it is not already running, but never installs it.
# KVITTO_LLM_ENABLED=1
# KVITTO_LLM_MODEL=qwen3-vl:4b
# KVITTO_LLM_BASE_URL=http://127.0.0.1:11434
# Set to 0 when something else owns the Ollama lifecycle (systemd, Docker, the
# Mac app) — the server will then only connect to it, never start or stop it.
# KVITTO_LLM_MANAGE_PROCESS=1
# Download the ~3 GB model on first use instead of waiting for POST /llm/pull.
# KVITTO_LLM_AUTO_PULL=0
# KVITTO_LLM_INTERVAL_SECONDS=60
# KVITTO_LLM_BATCH_SIZE=4
# Per-receipt deadline. CPU inference on a long receipt is slow.
# KVITTO_LLM_TIMEOUT_MS=300000
# KVITTO_LLM_MAX_ATTEMPTS=3

# --- serve the PWA from this server too (optional) ---
# KVITTO_STATIC_DIR=/app/web
