{
  "name": "@kvitto/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/index.domain.d.ts",
      "default": "./dist/index.domain.js"
    },
    "./ai-settings-ui": {
      "types": "./dist/ai-settings-ui.d.ts",
      "default": "./dist/ai-settings-ui.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./ui-rows": {
      "types": "./dist/ui-rows.d.ts",
      "default": "./dist/ui-rows.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "npm run build && node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "fast-sha256": "^1.3.0"
  }
}
